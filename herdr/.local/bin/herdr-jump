#!/bin/sh
# Jump to the herdr agent that needs attention, from anywhere in macOS.
# Bound to a global hotkey via skhd (cmd + shift - i, see skhd/skhdrc).
#
# Installed by hand, like the rest of this repo:
#
#   ln -s ~/code/dotfiles/herdr/bin/herdr-jump ~/.local/bin/herdr-jump

# skhd runs with a thin environment; don't rely on PATH.
PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

# Prefer an agent waiting on input; fall back to one that just finished.
pick() {
  echo "$1" | jq -r \
    "[.result.agents[] | select(.agent_status == \"$2\")]
     | sort_by(.state_change_seq) | last | .pane_id // empty"
}

agents=$(herdr agent list 2>/dev/null)
target=$(pick "$agents" blocked)
[ -n "$target" ] || target=$(pick "$agents" done)

[ -n "$target" ] && herdr agent focus "$target" >/dev/null 2>&1

open -a Ghostty
