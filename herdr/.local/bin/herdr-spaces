#!/usr/bin/env bash
set -euo pipefail

# herdr-spaces — pick a project directory and jump to its herdr space.
#
# The herdr counterpart of scripts/.local/bin/t: the same list of candidate directories
# (everything one level under ~/code, plus /tmp and ~/Downloads), and the same
# get-or-create behaviour — reuse the space already sitting in that directory,
# otherwise create one rooted there. tmux keys its sessions by name; herdr
# derives labels itself (a worktree space is labelled after its branch, not its
# path), so the match runs on the panes' cwd and only falls back to the label.
#
# The list goes up before herdr is asked anything. The snapshot only resolves
# the directory you picked, so it runs after the pick, hidden behind the jump.
#
# Launched from a herdr popup bound to prefix + j (see ~/.config/herdr/config.toml).
#
# Installed with GNU stow from the repo root: `stow herdr`.

# herdr popups run with a thin environment; don't rely on PATH.
PATH="/opt/homebrew/bin:$PATH"
HERDR="${HERDR_BIN:-$HOME/.local/bin/herdr}"

# Popups vanish the moment the command exits, so anything worth reading needs a
# keypress to hold it on screen.
hold() {
    echo "$1"
    if [[ -t 0 ]]; then
        echo "(press any key)"
        read -r -s -n 1 || true
    fi
}

# Candidate directories, same set as scripts/.local/bin/t.
candidates() {
    find "$HOME/code" -maxdepth 1 -mindepth 1 -type d
    echo /tmp
    echo "$HOME/Downloads"
}

# "workspace_id<TAB>label<TAB>cwd" for every pane, so a space rooted anywhere
# its panes sit can be found again.
SPACES=""
load_spaces() {
    SPACES=$("$HERDR" api snapshot 2>/dev/null | jq -r '
        .result.snapshot as $s
        | (($s.workspaces // []) | map({key: .workspace_id, value: .label}) | from_entries) as $ws
        | ($s.panes // [])[]
        | [ .workspace_id, ($ws[.workspace_id] // ""), (.cwd // "") ]
        | join("\t")
    ' 2>/dev/null) || SPACES=""
}

# herdr reports physical paths, so /tmp comes back as /private/tmp and would
# never match on a literal compare.
physical() {
    (cd "$1" 2>/dev/null && pwd -P) || echo "$1"
}

# The space to reuse for a directory, or empty. Exact cwd match first — a
# prefix match would send you into a worktree when you asked for the repo root.
# Falls back to the label for spaces whose shell has since cd'd elsewhere.
space_for() {
    local dir name workspace_id label cwd fallback=""
    dir=$(physical "$1")
    name="${1##*/}"

    [[ -n "$SPACES" ]] || return 0

    while IFS=$'\t' read -r workspace_id label cwd; do
        [[ -n "$workspace_id" ]] || continue
        [[ "$cwd" == "$dir" ]] && { echo "$workspace_id"; return 0; }
        [[ -z "$fallback" && "$label" == "$name" ]] && fallback="$workspace_id"
    done <<<"$SPACES"

    [[ -n "$fallback" ]] && echo "$fallback"
    return 0
}

main() {
    if [[ ! -x "$HERDR" ]]; then
        hold "herdr-spaces: no herdr binary at $HERDR."
        exit 0
    fi

    local selected
    if [[ $# -ge 1 ]]; then
        selected="$1"
    else
        selected=$(candidates | fzf --layout=reverse --prompt="space> ") || exit 0
    fi

    # Nothing selected when you ctrl-c out of fzf.
    [[ -n "$selected" ]] || exit 0

    if [[ ! -d "$selected" ]]; then
        hold "herdr-spaces: no such directory: $selected"
        exit 0
    fi

    load_spaces

    local existing
    existing=$(space_for "$selected")

    # A .bare project's root carries a .git pointer to it, so a plain space
    # there is already the repo's own space that its worktrees group under.
    if [[ -n "$existing" ]]; then
        "$HERDR" workspace focus "$existing" >/dev/null 2>&1 || true
    else
        "$HERDR" workspace create \
            --cwd "$selected" \
            --label "${selected##*/}" \
            --focus >/dev/null 2>&1 || true
    fi
}

main "$@"
