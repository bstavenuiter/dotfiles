font-size = 16
font-family = "FiraCode Nerd Font"

# Disable programming ligatures
font-feature = -calt

adjust-cell-height = 30%

quick-terminal-size = 75%,80%
quick-terminal-animation-duration = 0

# open quick terminal on the monitor with the mouse, avoids creating to small a window
quick-terminal-screen = mouse

keybind = global:cmd+backquote=toggle_quick_terminal

macos-option-as-alt = true

# no close window notification anymore, this was blocking restarts etc.
confirm-close-surface = false

notify-on-command-finish = unfocused
