+---codediff >= 2.50 returns typed Path tables from get_paths(); older versions
+---returned plain strings.
+---@param p string|table|nil
+---@return string|nil
+local function path_str(p)
+  if type(p) == "table" then
+    local abs = p.absolute
+    if abs == nil or abs == "" then
+      return nil
+    end
+    return abs
+  end
+  return p
+end
